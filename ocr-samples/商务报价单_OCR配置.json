{
  "id": "quotation-sheet",
  "name": "商务报价单",
  "keywords": [
    "报价单",
    "Quotation",
    "COMMERCIAL",
    "报价"
  ],
  "pages": "1",
  "dpi": 200,
  "fields": [
    {
      "key": "报价单号",
      "prompt": "提取商务报价单的报价编号，通常以 BJ 开头",
      "kind": "text",
      "multiple": false,
      "maxItems": 1,
      "separator": "、",
      "required": true,
      "fallback": "",
      "anchors": [
        "报价单号：",
        "报价单号",
        "报价编号：",
        "报价编号"
      ],
      "pattern": "BJ-\\d{8}-\\d{2}",
      "stripPrefixes": [
        "报价单号：",
        "报价单号:",
        "报价编号：",
        "报价编号:",
        "："
      ],
      "format": ""
    },
    {
      "key": "客户单位",
      "prompt": "提取询价方、客户单位全称，排除报价单位和供货商",
      "kind": "text",
      "multiple": false,
      "maxItems": 1,
      "separator": "、",
      "required": true,
      "fallback": "",
      "anchors": [
        "客户单位：",
        "客户单位",
        "客户名称：",
        "客户名称",
        "客户："
      ],
      "pattern": "",
      "stripPrefixes": [
        "客户单位：",
        "客户单位:",
        "客户名称：",
        "客户名称:",
        "客户：",
        "客户:",
        "："
      ],
      "format": ""
    },
    {
      "key": "报价日期",
      "prompt": "提取报价出具日期，严格排除有效期至与截止日期",
      "kind": "date",
      "multiple": false,
      "maxItems": 1,
      "separator": "、",
      "required": true,
      "fallback": "",
      "anchors": [
        "报价日期：",
        "报价日期",
        "制单日期：",
        "制单日期"
      ],
      "pattern": "",
      "stripPrefixes": [
        "报价日期：",
        "报价日期:",
        "制单日期：",
        "制单日期:",
        "："
      ],
      "format": "%Y%m%d"
    },
    {
      "key": "价税合计",
      "prompt": "提取报价单的最终含税总金额或价税合计，排除单价与参考价",
      "kind": "number",
      "multiple": false,
      "maxItems": 1,
      "separator": "、",
      "required": true,
      "fallback": "",
      "anchors": [
        "价税合计",
        "总金额",
        "合计金额",
        "报价总额"
      ],
      "pattern": "",
      "stripPrefixes": [
        "￥",
        "$",
        "价税合计：",
        "价税合计",
        "："
      ],
      "format": "2"
    }
  ],
  "filenamePattern": "{报价日期}_{客户单位}_{报价单号}",
  "threshold": 0.75,
  "extraTitles": [
    "商务设备报价单"
  ],
  "noiseMarkers": [
    "商机编号",
    "版本："
  ],
  "extraHeaders": []
}
